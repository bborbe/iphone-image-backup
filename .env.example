# iPhone Backup Tool Configuration
# Copy this file to .env and configure as needed

# Backup directory (optional, defaults to ~/Downloads/iPhoneImageBackup)
# BACKUP_DIRECTORY=~/MyBackups

# Date format for organizing files (optional, defaults to %Y/%Y-%m-%d)
# DATE_FORMAT=%Y/%Y-%m-%d

# Log file path (optional, defaults to iphone_backup.log)
# LOG_FILE=iphone_backup.log

# Configuration file path (optional, defaults to config.yaml)
# CONFIG_FILE=config.yaml
